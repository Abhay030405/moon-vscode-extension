{
  "name": "moon",
  "displayName": "Moon",
  "description": "Orbits your code. Lands only when you say yes. A coding agent running on TrueForge.",
  "version": "0.0.0",
  "private": true,
  "publisher": "moon",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhay030405/moon-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "scripts": {
    "build": "esbuild src/activate.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@moon/core": "workspace:*",
    "@types/vscode": "1.95.0"
  }
}
