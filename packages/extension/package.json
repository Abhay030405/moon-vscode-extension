{
  "name": "moon",
  "displayName": "Moon",
  "description": "Orbits your code. Lands only when you say yes. A coding agent running on TrueForge.",
  "version": "0.0.0",
  "private": true,
  "publisher": "moon",
  "license": "Apache-2.0",
  "icon": "media/moon-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhay030405/moon-vscode-extension.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "moon.checkSetup",
        "title": "Check setup",
        "category": "Moon"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moon",
          "title": "Moon. Orbits your code. Lands only when you say yes.",
          "icon": "media/moon.svg"
        }
      ]
    },
    "views": {
      "moon": [
        {
          "type": "webview",
          "id": "moon.panel",
          "name": "Moon. Orbits your code. Lands only when you say yes."
        }
      ]
    },
    "configuration": {
      "title": "Moon",
      "properties": {
        "moon.configPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Full path to Moon's `moon.json` config file. Leave empty to use `config/moon.json` in the Moon repository the extension runs from."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/activate.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@moon/core": "workspace:*",
    "@moon/webview-ui": "workspace:*",
    "@types/vscode": "1.95.0"
  }
}
