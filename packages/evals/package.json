{
  "name": "@moon/evals",
  "version": "0.0.0",
  "private": true,
  "description": "Evaluation harness, run from the command line against the real TrueForge (no VS Code).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "retrieval": "esbuild retrieval.ts --bundle --platform=node --format=cjs --outfile=dist/retrieval.cjs --log-level=warning && node dist/retrieval.cjs",
    "cancel": "esbuild cancel.ts --bundle --platform=node --format=cjs --outfile=dist/cancel.cjs --log-level=warning && node dist/cancel.cjs",
    "resilience": "esbuild resilience.ts --bundle --platform=node --format=cjs --outfile=dist/resilience.cjs --log-level=warning && node dist/resilience.cjs",
    "safety": "esbuild safety.ts --bundle --platform=node --format=cjs --outfile=dist/safety.cjs --log-level=warning && node dist/safety.cjs",
    "check-security": "esbuild check-security.ts --bundle --platform=node --format=cjs --outfile=dist/check-security.cjs --log-level=warning && node dist/check-security.cjs"
  },
  "dependencies": {
    "@moon/core": "workspace:*"
  }
}
