# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# These values are given to TrueForge only (as its model providers), never read by Moon's code.

# Main model: Anthropic (Claude Sonnet)
ANTHROPIC_API_KEY=

# Backup model: DeepSeek V4.1 Flash on Azure AI Foundry (OpenAI-compatible endpoint)
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
# Deployment name in Azure AI Foundry. In TrueForge (and in models.backup.model in config/moon.json)
# the model is named in lowercase with hyphens, e.g. deepseek-v4-1-flash-2.
AZURE_FOUNDRY_MODEL=DeepSeek-V4.1-Flash-2
