{
  "trueforge": {
    "version": "latest",
    "baseUrl": "http://localhost:8790",
    "port": 8790,
    "requestTimeoutMs": 5000,
    "statusCheckIntervalMs": 15000,
    "allowedOutboundHosts": ["localhost", "127.0.0.1"]
  },
  "models": {
    "main": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5"
    },
    "backup": {
      "provider": "azure-deepseek",
      "model": "deepseek-v4-1-flash-2"
    }
  },
  "resilience": {
    "watchdogMs": 12000,
    "rateLimitRetries": 2,
    "circuitBreaker": {
      "firstProbeMs": 30000,
      "backoffFactor": 2,
      "maxProbeMs": 600000
    }
  },
  "context": {
    "mapBudgetRatio": 0.1,
    "mapBudgetMinTokens": 1000,
    "mapBudgetMaxTokens": 8000,
    "fallbackContextLength": 50000
  },
  "tools": {
    "searchMaxResults": 50
  }
}
