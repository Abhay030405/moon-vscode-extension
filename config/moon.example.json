{
  "trueforge": {
    "version": "latest",
    "baseUrl": "http://localhost:8790",
    "port": 8790,
    "allowedOutboundHosts": ["localhost", "127.0.0.1"]
  },
  "models": {
    "main": { "provider": "anthropic", "model": "claude-sonnet-5-5" },
    "backup": { "provider": "azure-deepseek", "model": "DeepSeek-V4.1-Flash-2" }
  },
  "resilience": {
    "watchdogMs": 12000,
    "rateLimitRetries": 2,
    "circuitBreaker": {
      "firstProbeMs": 30000,
      "backoffFactor": 2,
      "maxProbeMs": 600000
    }
  },
  "context": {
    "mapBudgetRatio": 0.1,
    "mapBudgetMinTokens": 1000,
    "mapBudgetMaxTokens": 8000,
    "fallbackContextLength": 50000
  },
  "tools": {
    "searchMaxResults": 50
  },
  "flask": {
    "repoUrl": "https://github.com/pallets/flask.git",
    "tag": "3.1.3",
    "commit": "22d92470",
    "dir": "flask",
    "testRequirements": ["asgiref", "greenlet", "pytest==9.0.2", "python-dotenv"],
    "localIgnores": [".venv/", ".pytest_cache/"]
  }
}
